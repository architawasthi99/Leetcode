#include <bits/stdc++.h>
using namespace std;
int maxDistance(vector<int>& nums1, vector<int>& nums2) {
        int i=0,j=0;
        int n=nums1.size();
        int m=nums2.size();
        int maxdis=0;
        while(i<n && j<m){
            if(i>j){
                j++;
            }
            else if(nums1[i]<=nums2[j]){
                maxdis=max(maxdis,j-i);
                j++;
            }
            else{
                i++;
            }
        }
        return maxdis;
    }
int main() {
    vector<int> nums1 = {55,30,5,4,2};
    vector<int> nums2 = {100,20,10,10,5};
    int ans=maxDistance(nums1,nums2);
    cout<<ans<<endl;
    return 0;
}
