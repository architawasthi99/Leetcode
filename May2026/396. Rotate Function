class Solution {
public:
    int maxRotateFunction(vector<int>& nums) {
        int sum=0;
        int F=0;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i];
            F+=i*nums[i];
        }
        int result=F;
        for(int k=0;k<nums.size()-1;k++){
            int newF=F+sum-nums.size()*nums[nums.size()-1-k];
            result=max(result,newF);
            F=newF;
        }
        return result;
    }
};
