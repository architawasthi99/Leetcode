#include<iostream>
#include<vector>
using namespace std;
int climbstairs(int n){
    vector<int>dp(n+1);
    dp[0]=0;
    dp[1]=1;
    dp[2]=2;
    for(int i=3;i<=n;i++){
        dp[i]=dp[i-1]+dp[i-2];
    }
    return dp[n];
}
int main(){
    int n;
    cout<<"ENTER THE VALUE OF N: ";
    cin>>n;
    cout<<climbstairs(n);
    return 0;
}
